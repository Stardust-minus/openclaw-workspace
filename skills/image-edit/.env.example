# ComfyUI Image Edit Skill - Environment Variables

# ComfyUI instance URL (required)
# Example: http://localhost:8188 or http://your-server:58188
COMFYUI_URL=http://localhost:8188

# Default model name (optional)
# Options: HunyuanImage-3.0-Instruct, Qwen-Image-Edit
DEFAULT_MODEL=HunyuanImage-3.0-Instruct

# Default task type (optional)
# Options: image, recaption, think_recaption
DEFAULT_BOT_TASK=image
